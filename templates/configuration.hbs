<form class="codd-config" autocomplete="off">
  <section class="codd-config__schedule">
    <i class="fa-solid fa-calendar-days"></i>
    <div>
      <strong>{{localize "CODD.Config.IndividualSchedules"}}</strong>
      <span>{{localize "CODD.Config.IndividualSchedulesHint"}}</span>
    </div>
  </section>

  <section class="codd-config__victim-header">
    <h2>{{localize "CODD.Config.Victims"}}</h2>
    <p class="notes">{{localize "CODD.Config.VictimsHint"}}</p>

    <label class="codd-search">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input
        type="search"
        placeholder="{{localize "CODD.Config.SearchPlaceholder"}}"
        aria-label="{{localize "CODD.Config.SearchLabel"}}"
        data-codd-search
      >
    </label>
  </section>

  <div class="codd-actor-list">
    {{#if hasAvailableActors}}
      {{#each availableActors}}
        <section
          class="codd-victim-row"
          data-codd-actor="{{id}}"
          data-codd-actor-name="{{name}}"
        >
          <label class="codd-actor">
            <input type="checkbox" name="victims" value="{{id}}" {{checked selected}}>
            <img src="{{img}}" alt="">
            <span class="codd-actor__name">{{name}}</span>
            {{#if paladin}}
              <span class="codd-tag" title="{{localize "CODD.Config.PaladinLevel"}} {{paladinLevel}}">
                {{localize "CODD.Config.PaladinTag"}} {{paladinLevel}}
              </span>
            {{/if}}
            {{#if effect}}
              <i class="fa-solid fa-droplet codd-actor__drained" title="{{effect}}"></i>
            {{/if}}
          </label>

          <label class="codd-roll-mode-field">
            <span>{{localize "CODD.Config.RollMode"}}</span>
            <select data-codd-roll-mode data-codd-npc="{{npc}}">
              {{#each rollModeOptions}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>
                  {{label}}
                </option>
              {{/each}}
            </select>
          </label>

          <label class="codd-interval-field">
            <span>{{localize "CODD.Config.IntervalDays"}}</span>
            <div>
              <input
                type="number"
                min="1"
                max="365"
                value="{{intervalDays}}"
                data-codd-interval
                data-codd-inherited="{{intervalInherited}}"
                data-codd-victim-input
                title="{{localize "CODD.Config.IndividualIntervalHint"}}"
              >
              <button
                type="button"
                data-codd-use-global
                data-codd-victim-input
                title="{{localize "CODD.Config.UseGlobalInterval"}}"
                aria-label="{{localize "CODD.Config.UseGlobalInterval"}}"
              >
                <i class="fa-solid fa-rotate-left"></i>
              </button>
            </div>
          </label>
        </section>
      {{/each}}
    {{else}}
      <p class="codd-empty">{{localize "CODD.Config.NoActors"}}</p>
    {{/if}}
  </div>

  <details class="codd-settings-panel">
    <summary>
      <i class="fa-solid fa-sliders"></i>
      {{localize "CODD.Config.RuleSettings"}}
    </summary>
    <div class="codd-settings-grid">
      <label>
        <span>{{localize "CODD.Config.SaveDC"}}</span>
        <input type="number" min="1" max="30" value="{{settings.saveDC}}" data-codd-setting="saveDC">
      </label>
      <label>
        <span>{{localize "CODD.Config.PaladinChance"}}</span>
        <input type="number" min="0" max="10" value="{{settings.paladinChance}}" data-codd-setting="paladinChance">
      </label>
      <label>
        <span>{{localize "CODD.Config.FallbackAura"}}</span>
        <input type="number" min="0" max="10" value="{{settings.fallbackAuraBonus}}" data-codd-setting="fallbackAuraBonus">
      </label>
      <label>
        <span>{{localize "CODD.Config.GlobalIntervalDays"}}</span>
        <input type="number" min="1" max="365" value="{{settings.intervalDays}}" data-codd-setting="intervalDays">
      </label>
      <label>
        <span>{{localize "CODD.Config.LossFormula"}}</span>
        <input type="text" value="{{settings.abilityLossFormula}}" data-codd-setting="abilityLossFormula">
      </label>
      <label>
        <span>{{localize "CODD.Config.HealingPenalty"}}</span>
        <input type="number" min="0" max="20" value="{{settings.spellHealingPenalty}}" data-codd-setting="spellHealingPenalty">
      </label>
    </div>
  </details>

  <div class="form-group">
    <label for="codd-paladin">{{localize "CODD.Config.Paladin"}}</label>
    <div class="form-fields">
      <select id="codd-paladin" name="paladinActorId">
        {{#each auraSources}}
          <option value="{{id}}" {{#if chosen}}selected{{/if}}>
            {{name}}{{#if paladin}} — {{localize "CODD.Config.PaladinTag"}}{{/if}}
          </option>
        {{/each}}
      </select>
    </div>
    <p class="hint">{{localize "CODD.Config.PaladinHint"}}</p>
  </div>

  <section class="codd-config__tools">
    <button type="button" data-action="open-records">
      <i class="fa-solid fa-chart-column"></i>
      {{localize "CODD.Config.OpenRecords"}}
    </button>
    <button type="button" data-action="test-now">
      <i class="fa-solid fa-vial"></i>
      {{localize "CODD.Config.TestNow"}}
    </button>
    <button type="button" data-action="reset-schedule">
      <i class="fa-solid fa-clock-rotate-left"></i>
      {{localize "CODD.Config.ResetSchedule"}}
    </button>
    <button type="button" data-action="remove-effects" class="codd-danger-button">
      <i class="fa-solid fa-wand-magic-sparkles"></i>
      {{localize "CODD.Config.RemoveEffects"}}
    </button>
  </section>

  <footer class="sheet-footer flexrow">
    <button type="submit">
      <i class="fa-solid fa-floppy-disk"></i>
      {{localize "CODD.Config.Save"}}
    </button>
  </footer>
</form>
